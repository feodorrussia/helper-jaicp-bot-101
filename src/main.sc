require: slotfilling/slotFilling.sc
  module = sys.zb-common
theme: /

    state: hello
        q!: * (привет|здравствуй|доброе утро|добрый день|хай|hello) *
        a: Привет! Я бот-помощник. Спроси меня о погоде или курсе валют.
        a: Напиши, например: «Какая погода?» или «Курс доллара»

    state: weather
        q!: * (погод|температур|прогноз|какая погода|сколько градусов|расскажи о погоде|будет ли завтра дождь) *
        a: Сейчас в вашем городе +20°C, солнечно. Хорошего дня!

    state: currency
        q!: * (курс|валют|доллар|евро|сколько стоит|рубль|юань) *
        a: Курс доллара — 92 рубля, евро — 99 рублей. Данные актуальны на сегодня.

    state: NoMatch
        event!: noMatch
        a: Извините, я не понял. Спросите меня о погоде или курсе валют.

    state: Match
        event!: match
        a: Я не знаю, как ответить на это. Попробуйте написать «Погода» или «Курс валют».